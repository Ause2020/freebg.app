{
  "name": "freebg.app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "build:client": "vite build",
    "build:ssr": "vite build --ssr src/entry-server.tsx --outDir .ssr --emptyOutDir",
    "prerender": "node scripts/prerender.mjs",
    "assets": "node scripts/generate-assets.mjs",
    "verify": "node scripts/verify-build.mjs",
    "build": "npm run typecheck && npm run build:client && npm run build:ssr && npm run prerender && npm run verify",
    "lint": "oxlint",
    "serve": "node scripts/serve.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@imgly/background-removal": "^1.7.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.28.0",
    "onnxruntime-web": "^1.21.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "oxlint": "^1.75.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^6.4.3"
  }
}
